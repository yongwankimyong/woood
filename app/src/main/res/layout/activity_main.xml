<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wood_dark">

    <TextView
        android:id="@+id/titleBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_wood_gradient"
        android:paddingVertical="18dp"
        android:paddingHorizontal="20dp"
        android:text="@string/app_name"
        android:textColor="@color/wood_cream"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:layout_constraintBottom_toTopOf="@id/controlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/switchCameraButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_switch_camera_button"
        android:src="@android:drawable/ic_menu_rotate"
        android:contentDescription="카메라 전환"
        android:scaleType="centerInside"
        android:padding="10dp"
        app:tint="@color/wood_cream"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <ImageView
        android:id="@+id/capturedImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:background="@color/wood_dark"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:layout_constraintBottom_toTopOf="@id/frameSelectorScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/frameSelectorScroll"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/wood_dark"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <Button
                android:id="@+id/frameNoneBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_frame_chip"
                android:text="없음"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/frameWoodBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_frame_chip"
                android:text="우드 테두리"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/framePolaroidBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_frame_chip"
                android:text="폴라로이드"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/frameHeartBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_frame_chip"
                android:text="하트"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/frameFilmBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_frame_chip"
                android:text="필름 스트립"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/frameStarBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_frame_chip"
                android:text="별빛"
                android:textColor="@color/wood_cream"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 카운트다운 숫자 표시 (3초 타이머용) -->
    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/wood_gold"
        android:textSize="90sp"
        android:textStyle="bold"
        android:shadowColor="@color/wood_dark"
        android:shadowRadius="12"
        android:shadowDx="0"
        android:shadowDy="0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/permission_denied_msg"
        android:textColor="@color/wood_cream"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/titleBar"
        app:layout_constraintBottom_toTopOf="@id/controlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_wood_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/shutterButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:contentDescription="촬영"
            android:src="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/resultButtonRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_outline_button"
                android:text="@string/retake_btn"
                android:textColor="@color/wood_white"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp" />

            <Button
                android:id="@+id/printButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_gold_button"
                android:text="@string/print_btn"
                android:textColor="@color/wood_white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
